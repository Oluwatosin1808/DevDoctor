{
  "name": "cdoc",
  "version": "0.1.0",
  "private": true,
  "description": "cDoc monorepo — a developer-first diagnostic CLI and its marketing site.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cdoc/web",
    "build": "npm run build --workspace @cdoc/web",
    "start": "npm run start --workspace @cdoc/web",
    "lint": "npm run lint --workspace @cdoc/web",
    "typecheck": "npm run typecheck --workspace @cdoc/web"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}

{
  "name": "@cdoc/cli",
  "version": "0.1.0",
  "private": true,
  "description": "cDoc — a local-first diagnostic CLI foundation for JavaScript and TypeScript projects.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cdoc": "./bin/cdoc.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oluwatosin1808/cDoc.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Oluwatosin1808/cDoc#readme",
  "bugs": {
    "url": "https://github.com/Oluwatosin1808/cDoc/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scan": "node ./bin/cdoc.js scan",
    "test": "node --test \"test/*.test.js\"",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "keywords": [
    "cli",
    "diagnostics",
    "local-first",
    "javascript",
    "typescript"
  ]
}

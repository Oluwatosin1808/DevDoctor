{
  "name": "@oluwat0s1n/devdoctor",
  "version": "0.1.0",
  "description": "DevDoctor — a developer-first diagnostic CLI that scans JavaScript and TypeScript projects for configuration, dependency, environment, git and security issues.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "devdoctor": "./bin/devdoctor.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oluwatosin1808/DevDoctor.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Oluwatosin1808/DevDoctor#readme",
  "bugs": {
    "url": "https://github.com/Oluwatosin1808/DevDoctor/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scan": "node ./bin/devdoctor.js scan",
    "test": "node --test test/cli.test.js",
    "prepublishOnly": "node ./bin/devdoctor.js --version"
  },
  "keywords": [
    "cli",
    "diagnostics",
    "security",
    "lint",
    "code-quality",
    "dependencies",
    "javascript",
    "typescript"
  ]
}
